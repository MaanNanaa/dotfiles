{

  // ------------------------------------------------------------
  // Line numbers
  // ------------------------------------------------------------
  
  // VS Code controls line-number behavior through editor.lineNumbers.
  // Keep normal line numbers enabled by default.
  // To use relative line numbers, swap the commented lines below.

  "editor.lineNumbers": "on",
  // "editor.lineNumbers": "relative",
  
  // ------------------------------------------------------------
  // Appearance
  // ------------------------------------------------------------

  "workbench.colorTheme": "Darcula (IntelliJ)",
  "editor.fontFamily": "'JetBrains Mono', Menlo, Monaco, monospace",
  "editor.fontSize": 16,
  "editor.minimap.enabled": false,
  "workbench.startupEditor": "none",
  "update.showReleaseNotes": false,
  "extensions.ignoreRecommendations": true,
  "chat.viewSessions.orientation": "stacked",

  // ------------------------------------------------------------
  // File associations
  // ------------------------------------------------------------

  // Open .sql files using the Oracle SQL Developer language mode.
  "files.associations": {
    "*.sql": "oracle-sql"
  },

  // ------------------------------------------------------------
  // Oracle SQL Developer extension
  // ------------------------------------------------------------

  "sqldeveloper.datagrid.fontFamily": "Menlo, Monaco, 'Courier New', monospace",
  "sqldeveloper.telemetry.enabled": false,

  // ------------------------------------------------------------
  // Telemetry
  // ------------------------------------------------------------

  "redhat.telemetry.enabled": false,
  "telemetry.feedback.enabled": false,

  // ------------------------------------------------------------
  // Vim-friendly editor behavior
  // ------------------------------------------------------------

  // Do not automatically insert closing brackets or quotes.
  "editor.autoClosingBrackets": "never",
  "editor.autoClosingQuotes": "never",

  // Do not accept regular IntelliSense suggestions with Tab or Enter.
  "editor.tabCompletion": "off",
  "editor.acceptSuggestionOnEnter": "on",

  // Keep inline ghost text enabled so manually requested Copilot
  // suggestions can be displayed.
  "editor.inlineSuggest.enabled": true,

  // Keep GitHub Copilot enabled for all supported file types.
  "github.copilot.enable": {
    "*": true
  },

  // Disable Copilot Next Edit Suggestions.
  // This keeps Copilot focused on suggestions at the current cursor.
  "github.copilot.nextEditSuggestions.enabled": false,

  // ------------------------------------------------------------
  // VSCodeVim — mirror of .ideavimrc
  // ------------------------------------------------------------

  "vim.leader": "<space>",
  "vim.scroll": 8,
  "vim.ignorecase": true,
  "vim.smartcase": true,
  "vim.incsearch": true,
  "vim.hlsearch": true,

  "vim.normalModeKeyBindingsNonRecursive": [
    { "before": ["g", "d"], "commands": ["editor.action.revealDefinition"] },
    { "before": ["g", "i"], "commands": ["editor.action.goToImplementation"] },
    { "before": ["g", "r"], "commands": ["editor.action.referenceSearch.trigger"] },
    { "before": ["K"], "commands": ["editor.action.showHover"] },

    { "before": ["<leader>", "f", "f"], "commands": ["workbench.action.quickOpen"] },
    { "before": ["<leader>", "f", "c"], "commands": ["workbench.action.showAllSymbols"] },
    { "before": ["<leader>", "f", "s"], "commands": ["workbench.action.gotoSymbol"] },
    { "before": ["<leader>", "f", "g"], "commands": ["workbench.action.findInFiles"] },
    { "before": ["<leader>", "f", "r"], "commands": ["workbench.action.openRecent"] },
    { "before": ["<leader>", "f", "u"], "commands": ["references-view.findReferences"] },

    { "before": ["<leader>", "c", "a"], "commands": ["editor.action.quickFix"] },
    { "before": ["<leader>", "c", "f"], "commands": ["editor.action.formatDocument"] },
    { "before": ["<leader>", "c", "i"], "commands": ["editor.action.organizeImports"] },

    { "before": ["<leader>", "r", "n"], "commands": ["editor.action.rename"] },
    { "before": ["<leader>", "r", "m"], "commands": ["java.action.refactorExtractMethod"] },
    { "before": ["<leader>", "r", "v"], "commands": ["java.action.refactorExtractVariable"] },
    { "before": ["<leader>", "r", "c"], "commands": ["java.action.refactorChangeSignature"] }
  ],

  "vim.visualModeKeyBindingsNonRecursive": [
    { "before": ["<leader>", "r", "m"], "commands": ["java.action.refactorExtractMethod"] },
    { "before": ["<leader>", "r", "v"], "commands": ["java.action.refactorExtractVariable"] }
  ]

}
